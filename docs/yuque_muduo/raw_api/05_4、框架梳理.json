  "content_updated_at": "2025-11-22T06:23:12.000Z",
  "created_at": "2025-01-06T08:28:38.000Z",
  "updated_at": "2026-05-11T13:50:10.000Z",
  "published_at": "2025-11-22T06:23:12.000Z",
